<article>

    <h1><%= reserva.sala %></h1>

    <dl class="datos">
        <dt>Estudiante</dt>
        <dd><%= reserva.estudiante %></dd>

        <dt>Email</dt>
        <dd><%= reserva.email %></dd>

        <dt>Fecha</dt>
        <dd><%= reserva.fecha %></dd>

        <dt>Turno</dt>
        <dd><%= reserva.turno %></dd>

        <dt>Personas</dt>
        <dd><%= reserva.personas %></dd>

        <dt>Estado</dt>
        <dd><%= reserva.estado %></dd>
    </dl>

    <p>
        <a class="boton" href="/reservas/<%= reserva.id %>/editar">Editar reserva</a>
        <a class="boton secundario" href="/reservas/<%= reserva.id %>/estado">Cambiar estado</a>
        <a class="boton secundario" href="/reservas/<%= reserva.id %>/eliminar">Eliminar reserva</a>
        <a href="/reservas">Volver al listado de reservas</a>
    </p>

</article>
